{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm db:generate && pnpm --filter api build && pnpm --filter web build",
  "outputDirectory": "apps/web/dist",
  "regions": ["cle1"],
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60,
      "regions": ["cle1"]
    }
  },
  "rewrites": [
    { "source": "/api/:path((?!$).*)", "destination": "/api/[...path]?__p=:path" },
    {
      "source": "/products/:seller/:file",
      "destination": "https://iuivtgpvvvspbxnptbwt.supabase.co/storage/v1/object/public/cho-viet/products/:seller/:file"
    },
    { "source": "/:path((?!api/).*)", "destination": "/index.html" }
  ]
}
