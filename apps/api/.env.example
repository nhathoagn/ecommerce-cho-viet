JWT_REFRESH_TTL_SECONDS=2592000

# MoMo sandbox. The old public sample keys (MOMOBKUN20180529) are declined by
# test-payment.momo.vn with resultCode 99. For development either set
# DEV_FORCE_LOCAL_PAYMENT=true (order becomes PAID locally, MoMo skipped) or
# paste sandbox keys from your own partner account (developers.momo.vn onboarding).
