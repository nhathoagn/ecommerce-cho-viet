NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# Payment is demo-only: the app shows a fixed QR and the buyer confirms.
# No provider keys are needed and nothing leaves this machine.
OPS_API_KEY=local-operations-key-change-me

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_PUBLIC=ecommerce-public
CLOUDFLARE_R2_BUCKET_PRIVATE=ecommerce-private
CLOUDFLARE_R2_PUBLIC_URL=
