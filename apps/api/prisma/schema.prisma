generator client {
  provider = "prisma-client-js"
  // Vercel functions run on Linux arm64; rhel covers an x64 fallback, native covers local dev.
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  BUYER
  SELLER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PACKING
  SHIPPING
  DELIVERED
  COMPLETED
  CANCELLED
  REFUND_REQUESTED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum StoreStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
}

enum InventoryTransactionType {
  INITIAL
  ADJUSTMENT
  SALE
  RESTOCK
  RETURN
}

enum WalletTransactionType {
  ORDER_CREDIT
  REFUND_DEBIT
  WITHDRAWAL_DEBIT
  ADJUSTMENT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  avatarUrl     String?
  role          UserRole       @default(BUYER)
  status        UserStatus     @default(ACTIVE)
  store         Store?
  orders        Order[]
  refreshTokens RefreshToken[]
  addresses     Address[]
  cart          Cart?
  wallet        SellerWallet?
  auditLogs     AuditLog[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  line1         String
  line2         String?
  ward          String?
  district      String
  city          String
  postalCode    String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Store {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  logoKey     String?
  bannerKey   String?
  status      StoreStatus @default(ACTIVE)
  sellerId    String      @unique
  seller      User        @relation(fields: [sellerId], references: [id])
  products    Product[]
  orders      Order[]
  coupons     Coupon[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  imageKey  String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Product {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  sku                   String                 @unique
  description           String?
  price                 Decimal                @db.Decimal(14, 0)
  compareAtPrice        Decimal?               @db.Decimal(14, 0)
  stock                 Int                    @default(0)
  status                ProductStatus          @default(DRAFT)
  storeId               String
  store                 Store                  @relation(fields: [storeId], references: [id])
  categoryId            String?
  category              Category?              @relation(fields: [categoryId], references: [id])
  images                ProductImage[]
  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]
  cartItems             CartItem[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([storeId, status])
  @@index([categoryId, status])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  objectKey String
  altText   String?
  position  Int      @default(0)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([productId, objectKey])
}

model InventoryTransaction {
  id        String                   @id @default(cuid())
  productId String
  product   Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      InventoryTransactionType
  quantity  Int
  before    Int
  after     Int
  reason    String?
  createdAt DateTime                 @default(now())

  @@index([productId, createdAt])
}

model Order {
  id              String               @id @default(cuid())
  code            String               @unique
  buyerId         String
  buyer           User                 @relation(fields: [buyerId], references: [id])
  storeId         String
  store           Store                @relation(fields: [storeId], references: [id])
  status          OrderStatus          @default(PENDING_PAYMENT)
  subtotal        Decimal              @db.Decimal(14, 0)
  discountAmount  Decimal              @default(0) @db.Decimal(14, 0)
  shippingAmount  Decimal              @default(0) @db.Decimal(14, 0)
  totalAmount     Decimal              @db.Decimal(14, 0)
  shippingAddress Json
  couponCode      String?
  items           OrderItem[]
  payment         Payment?
  statusHistory   OrderStatusHistory[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([buyerId, createdAt])
  @@index([storeId, status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  unitPrice   Decimal @db.Decimal(14, 0)
  quantity    Int
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  order                 Order         @relation(fields: [orderId], references: [id])
  provider              String        @default("MOMO")
  providerTransactionId String?       @unique
  requestId             String        @unique
  amount                Decimal       @db.Decimal(14, 0)
  status                PaymentStatus @default(PENDING)
  resultCode            Int?
  payUrl                String?
  refundedAmount        Decimal       @default(0) @db.Decimal(14, 0)
  paidAt                DateTime?
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  storeId        String
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  percentOff     Int?
  fixedAmountOff Decimal?  @db.Decimal(14, 0)
  minOrderAmount Decimal   @default(0) @db.Decimal(14, 0)
  maxUses        Int?
  usedCount      Int       @default(0)
  active         Boolean   @default(true)
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model SellerWallet {
  id               String              @id @default(cuid())
  sellerId         String              @unique
  seller           User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  availableBalance Decimal             @default(0) @db.Decimal(14, 0)
  transactions     WalletTransaction[]
  withdrawals      WithdrawalRequest[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model WalletTransaction {
  id          String                @id @default(cuid())
  walletId    String
  wallet      SellerWallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  reference   String                @unique
  type        WalletTransactionType
  amount      Decimal               @db.Decimal(14, 0)
  description String
  createdAt   DateTime              @default(now())

  @@index([walletId, createdAt])
}

model WithdrawalRequest {
  id            String           @id @default(cuid())
  walletId      String
  wallet        SellerWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount        Decimal          @db.Decimal(14, 0)
  bankName      String
  accountNumber String
  accountName   String
  status        WithdrawalStatus @default(PENDING)
  note          String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([walletId, status])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
